@startuml
title Alur End-to-End Bantuan CSR - Pengajuan sampai BAST Disetujui

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #0F172A
skinparam nodesep 10
skinparam ranksep 16
skinparam swimlaneBorderColor #94A3B8
skinparam swimlaneTitleBackgroundColor #E2E8F0
skinparam swimlaneTitleFontColor #0F172A
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #0F172A
  FontColor #0F172A
  DiamondBackgroundColor #FEF3C7
  DiamondBorderColor #B45309
  StartColor #16A34A
  EndColor #DC2626
}

|Admin|
start
:Login ke area Admin;

|Sistem|
:Validasi akun aktif,\nkredensial, dan role Admin;

while (Login belum valid?) is (Ya)
  :Tampilkan pesan kesalahan;

  |Admin|
  :Masukkan ulang kredensial;

  |Sistem|
  :Validasi ulang;
endwhile (Tidak)

repeat
  |Admin|
  :Buka form Bantuan CSR;
  :Isi data bantuan, pilar, anggaran,\ntarget, rincian, dan foto;
  :Unggah dokumen A dan B;
  :Simpan draft atau ajukan;

  |Sistem|
  :Validasi data dan file;

  if (Pengajuan valid dan lengkap?) then (Tidak)
    :Pertahankan status draft;
    :Tampilkan bagian yang harus diperbaiki;

    |Admin|
    :Lengkapi data atau dokumen;
  else (Ya)
    :Set status pending_fase1;
    :Simpan waktu pengajuan dan status log;
    :Kirim notifikasi ke seluruh Super Admin aktif;
  endif
repeat while (Belum pending_fase1?) is (Ya)
->Tidak;

|Super Admin|
:Buka pengajuan pending_fase1;
:Periksa data, target, rincian,\nfoto, serta dokumen A dan B;
note right
  Tampilan Super Admin read-only.
  Tidak ada aksi edit, unggah,
  ganti, atau hapus konten.
  Aksi hanya Setujui atau Tolak.
end note

if (Pengajuan layak?) then (Tidak)
  :Isi alasan penolakan wajib;

  |Sistem|
  :Set status rejected_fase1;
  :Simpan reviewer, waktu, alasan,\ndan status log;
  :Kirim notifikasi kepada Admin pembuat;

  |Admin|
  :Baca alasan penolakan;
  :Pengajuan berakhir dan\ntidak lanjut ke BAST;
  stop
else (Ya)
  |Super Admin|
  :Setujui dokumen awal;

  |Sistem|
  :Pastikan dokumen A dan B tersedia;
  :Set status approved_fase1;
  :Simpan reviewer, waktu, dan status log;
  :Kirim notifikasi kepada Admin pembuat;
endif

repeat
  |Admin|
  :Buka halaman BAST Bantuan CSR;
  :Unggah atau perbaiki BAST;
  :Tambahkan dokumentasi pendukung;
  :Klik Ajukan BAST;

  |Sistem|
  :Validasi kepemilikan, status,\ntipe, ukuran, dan file BAST;

  if (BAST valid?) then (Tidak)
    :Tampilkan pesan kesalahan;
    :Pertahankan status approved_fase1;

    |Admin|
    :Perbaiki file atau input;
  else (Ya)
    :Ganti BAST lama dan simpan foto baru;
    :Set status pending_fase2;
    :Catat status log;
    :Kirim notifikasi ke seluruh Super Admin aktif;

    |Super Admin|
    :Periksa BAST dan dokumentasi;
    note right
      BAST dikelola dan diunggah oleh Admin.
      Tampilan Super Admin read-only.
      Aksi hanya Setujui atau Tolak;
      penolakan wajib disertai alasan.
    end note

    if (BAST layak?) then (Tidak)
      :Isi alasan penolakan wajib;

      |Sistem|
      :Kembalikan status ke approved_fase1;
      :Simpan reviewer, waktu, alasan,\ndan status log;
      :Kirim notifikasi kepada Admin pembuat;

      |Admin|
      :Perbaiki BAST saja;
      note right
        Dokumen A dan B tidak
        diajukan ulang.
      end note
    else (Ya)
      |Super Admin|
      :Setujui BAST;

      |Sistem|
      :Pastikan dokumen BAST tersedia;
      :Set status completed;
      :Simpan reviewer, waktu, dan status log;
      :Kirim notifikasi kepada Admin pembuat;
      :Perbarui hasil monitoring;
    endif
  endif
repeat while (Status belum completed?) is (Ya)
->Tidak;

|Admin|
:Bantuan CSR selesai;
stop
@enduml
